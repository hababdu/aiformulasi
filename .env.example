# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# O'qituvchi(lar)ning Telegram ID raqami, vergul bilan ajratiladi
# ID ni @userinfobot orqali bilib olish mumkin
ADMIN_IDS=111111111,222222222

# Ixtiyoriy. Odatda kerak emas: baza kanali va o'quvchilar guruhi botning o'zida ulanadi
# (/setchannel, /setgroup yoki botni kanalga admin qilganda / guruhga qo'shganda chiqadigan tugma).
# Berilsa, bot ichidagi sozlamadan ustun turadi.
# STORAGE_CHANNEL_ID=-1001234567890
# GROUP_ID=-1009876543210

# Ixtiyoriy: lokal baza fayli joyi (standart: homework.db)
