# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# O'qituvchi(lar)ning Telegram ID raqami, vergul bilan ajratiladi
# ID ni @userinfobot orqali bilib olish mumkin
ADMIN_IDS=111111111,222222222

# Bazani saqlaydigan YOPIQ kanal ID si (-100... bilan boshlanadi).
# Bot kanalda admin bo'lishi kerak: xabar yuborish, tahrirlash va pin qilish huquqlari bilan.
# Bo'sh qoldirilsa, baza faqat lokal homework.db faylida turadi.
STORAGE_CHANNEL_ID=-1001234567890

# O'quvchilar guruhi ID si (-100... bilan boshlanadi). Bot guruh a'zosi bo'lishi kerak
# (a'zolarning kirish/chiqishini ko'rishi uchun admin qilish tavsiya etiladi).
GROUP_ID=-1009876543210

# Ixtiyoriy: lokal baza fayli joyi (standart: homework.db)
# DB_PATH=homework.db
